# Copy this to .env and fill in your values
# .env is gitignored — never commit real credentials

# Local paths (used when running locally, not on Databricks)
BRONZE_PATH=./data/bronze
SILVER_PATH=./data/silver
GOLD_PATH=./data/gold

# Source data URL pattern — NYC TLC open data
# Replace YYYY and MM with year and month e.g. 2024 and 01
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data

# Optional: Databricks workspace (only needed if deploying to Databricks)
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your_token_here
